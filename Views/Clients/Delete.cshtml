@model FitTrack.Models.Client

@{
    ViewData["Title"] = "Delete Client";
}

<div class="page-header mb-4"><p class="section-kicker mb-1">CLIENT MANAGEMENT</p><h1>Delete Client</h1></div>
<div class="alert alert-warning" role="alert">
    Are you sure you want to delete this client? This action cannot be undone.
</div>

<div class="details-card card mb-4">
    <div class="card-body">
        <h2 class="h4">@Model.FullName</h2>
        <p class="mb-0">@Model.Age years old · @Model.FitnessGoal</p>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete Client</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
