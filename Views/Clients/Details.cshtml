@model FitTrack.Models.Client
@using System.Text.Json

@{
    ViewData["Title"] = "Client Details";
    var progressRecords = ViewBag.ProgressRecords as List<FitTrack.Models.ProgressRecord> ?? [];
    var chartLabels = JsonSerializer.Serialize(progressRecords.Select(record => record.RecordDate.ToString("yyyy-MM-dd")));
    var weightData = JsonSerializer.Serialize(progressRecords.Select(record => record.Weight));
    var bodyFatData = JsonSerializer.Serialize(progressRecords.Select(record => record.BodyFatPercentage));
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1>Client Details</h1>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-controller="ProgressRecords" asp-action="Index" asp-route-clientId="@Model.Id" class="btn btn-outline-success">View Progress</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Clients</a>
    </div>
</div>

<div class="details-card card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.FullName)</dt>
            <dd class="col-sm-8">@Model.FullName</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Age)</dt>
            <dd class="col-sm-8">@Model.Age</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Gender)</dt>
            <dd class="col-sm-8">@Model.Gender</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Weight)</dt>
            <dd class="col-sm-8">@Model.Weight kg</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Height)</dt>
            <dd class="col-sm-8">@Model.Height cm</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.FitnessGoal)</dt>
            <dd class="col-sm-8">@Model.FitnessGoal</dd>
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.DateJoined)</dt>
            <dd class="col-sm-8">@Model.DateJoined.ToString("d")</dd>
        </dl>
    </div>
</div>

<div class="bmi-card mt-4">
    <div>
        <p class="section-kicker mb-1">BODY METRIC</p>
        <h2 class="h5 mb-0">Body Mass Index</h2>
        <p class="text-muted small mb-0">Calculated from weight and height.</p>
    </div>
    <div class="bmi-result">
        <span class="bmi-value">@(Model.Bmi?.ToString("0.0") ?? "—")</span>
        <span class="bmi-category">@Model.BmiCategory</span>
    </div>
</div>

<section class="progress-chart-panel mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <p class="section-kicker mb-1">PROGRESS OVER TIME</p>
            <h2 class="h4 mb-0">Progress charts</h2>
        </div>
        <a asp-controller="ProgressRecords" asp-action="Create" asp-route-clientId="@Model.Id" class="btn btn-sm btn-primary">Record Progress</a>
    </div>

    @if (progressRecords.Count == 0)
    {
        <div class="alert alert-info mb-0" role="alert">
            No progress records are available for @Model.FullName yet. Record a progress update to see charts here.
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="chart-card">
                    <h3 class="h6">Weight changes <span>(kg)</span></h3>
                    <div class="chart-container">
                        <canvas id="weightChart" aria-label="Weight changes over time"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="chart-card">
                    <h3 class="h6">Body-fat changes <span>(%)</span></h3>
                    <div class="chart-container">
                        <canvas id="bodyFatChart" aria-label="Body-fat percentage changes over time"></canvas>
                    </div>
                </div>
            </div>
        </div>
    }
</section>

@if (progressRecords.Count > 0)
{
    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
        <script>
            const chartLabels = @Html.Raw(chartLabels);
            const weightData = @Html.Raw(weightData);
            const bodyFatData = @Html.Raw(bodyFatData);
            const chartGridColor = 'rgba(255, 255, 255, 0.06)';
            const chartTextColor = '#7f8b98';

            Chart.defaults.font.family = '"Inter", ui-sans-serif, system-ui, sans-serif';
            Chart.defaults.color = chartTextColor;

            // Vertical fade under each line, sized to the chart area once it is known.
            const areaGradient = (rgb) => ({ chart }) => {
                const { ctx, chartArea } = chart;
                if (!chartArea) {
                    return `rgba(${rgb}, 0.15)`;
                }
                const gradient = ctx.createLinearGradient(0, chartArea.top, 0, chartArea.bottom);
                gradient.addColorStop(0, `rgba(${rgb}, 0.35)`);
                gradient.addColorStop(1, `rgba(${rgb}, 0)`);
                return gradient;
            };

            const chartOptions = {
                responsive: true,
                maintainAspectRatio: false,
                animation: {
                    duration: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 900,
                    easing: 'easeOutQuart'
                },
                interaction: {
                    intersect: false,
                    mode: 'index'
                },
                scales: {
                    x: {
                        grid: { display: false },
                        border: { display: false },
                        ticks: { color: chartTextColor, maxRotation: 0, autoSkipPadding: 16 }
                    },
                    y: {
                        beginAtZero: false,
                        grid: { color: chartGridColor },
                        border: { display: false },
                        ticks: { color: chartTextColor, padding: 8 }
                    }
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: 'rgba(13, 17, 22, 0.95)',
                        borderColor: 'rgba(255, 106, 0, 0.35)',
                        borderWidth: 1,
                        titleColor: '#f5f7fa',
                        bodyColor: '#b4bdc8',
                        padding: 12,
                        cornerRadius: 10,
                        displayColors: false
                    }
                }
            };

            const lineDataset = (label, data, hex, rgb) => ({
                label,
                data,
                borderColor: hex,
                borderWidth: 2.5,
                backgroundColor: areaGradient(rgb),
                fill: true,
                tension: 0.35,
                pointBackgroundColor: '#0d1116',
                pointBorderColor: hex,
                pointBorderWidth: 2,
                pointRadius: 4,
                pointHoverRadius: 6,
                pointHoverBackgroundColor: hex
            });

            new Chart(document.getElementById('weightChart'), {
                type: 'line',
                data: {
                    labels: chartLabels,
                    datasets: [lineDataset('Weight (kg)', weightData, '#ff8a1f', '255, 138, 31')]
                },
                options: chartOptions
            });

            new Chart(document.getElementById('bodyFatChart'), {
                type: 'line',
                data: {
                    labels: chartLabels,
                    datasets: [lineDataset('Body fat (%)', bodyFatData, '#5cb8ff', '92, 184, 255')]
                },
                options: chartOptions
            });
        </script>
    }
}
