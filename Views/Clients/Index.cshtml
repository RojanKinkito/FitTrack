@model IEnumerable<FitTrack.Models.Client>

@{
    ViewData["Title"] = "Clients";
    var searchTerm = ViewData["SearchTerm"] as string;
    var selectedGender = ViewData["SelectedGender"] as string;
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1>Clients</h1>
        <p class="text-muted mb-0">Manage your FitTrack clients.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Create Client</a>
</div>

<form asp-action="Index" method="get" class="filter-toolbar row g-2 mb-4">
    <div class="col-md-6">
        <label for="searchTerm" class="visually-hidden">Search clients</label>
        <input id="searchTerm" name="searchTerm" value="@searchTerm" class="form-control" placeholder="Search by name, gender, or fitness goal" />
    </div>
    <div class="col-md-4">
        <label for="gender" class="visually-hidden">Filter by gender</label>
        <select id="gender" name="gender" asp-items="ViewBag.Genders" class="form-select">
            <option value="">All genders</option>
        </select>
    </div>
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="empty-state-panel" role="status">
        No clients match the current search. <a asp-action="Create" class="alert-link">Create a client</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table data-table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.FullName)</th>
                    <th>@Html.DisplayNameFor(model => model.Age)</th>
                    <th>@Html.DisplayNameFor(model => model.Gender)</th>
                    <th>@Html.DisplayNameFor(model => model.Weight)</th>
                    <th>@Html.DisplayNameFor(model => model.Height)</th>
                    <th>@Html.DisplayNameFor(model => model.FitnessGoal)</th>
                    <th>@Html.DisplayNameFor(model => model.DateJoined)</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var client in Model)
                {
                    <tr>
                        <td>@client.FullName</td>
                        <td>@client.Age</td>
                        <td>@client.Gender</td>
                        <td>@client.Weight kg</td>
                        <td>@client.Height cm</td>
                        <td>@client.FitnessGoal</td>
                        <td>@client.DateJoined.ToString("d")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@client.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                            <a asp-action="Edit" asp-route-id="@client.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Delete" asp-route-id="@client.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
