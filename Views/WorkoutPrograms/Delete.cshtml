@model FitTrack.Models.WorkoutProgram

@{
    ViewData["Title"] = "Delete Workout Program";
}

<div class="page-header mb-4"><p class="section-kicker mb-1">WORKOUT PROGRAMS</p><h1>Delete Workout Program</h1></div>
<div class="alert alert-warning" role="alert">
    Are you sure you want to delete this workout program? This action cannot be undone.
</div>

<div class="details-card card mb-4">
    <div class="card-body">
        <h2 class="h4">@Model.ProgramName</h2>
        <p class="mb-0">Assigned to @Model.Client?.FullName · @Model.DurationWeeks weeks · @Model.DifficultyLevel</p>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete Program</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
